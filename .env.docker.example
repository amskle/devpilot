# Copy this file to .env and replace every placeholder before startup.
DEVPILOT_BIND_ADDRESS=127.0.0.1
DEVPILOT_HTTP_PORT=8080
DEVPILOT_TOOLCHAIN_PROFILE=python
DEVPILOT_API_WORKERS=1

# Windows Docker Desktop example: C:/repos
# Linux example: /srv/repos
DEVPILOT_REPOSITORY_ROOT_HOST=C:/repos

DEVPILOT_MODEL_API_KEY=replace-me
DEVPILOT_MODEL_BASE_URL=https://api.openai.com/v1
DEVPILOT_MODEL=gpt-5-mini

# Production-mode tokens must contain at least 32 characters.
DEVPILOT_API_TOKENS={"replace-with-at-least-32-random-characters":{"subject":"local-operator","admin":true}}

