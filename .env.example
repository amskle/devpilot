# Local CLI configuration. Copy this file to .env and replace the placeholders.
DEVPILOT_MODEL_API_KEY=replace-me
DEVPILOT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEVPILOT_MODEL=deepseek-v4-flash-0731
# Optional Langfuse tracing (SDK reads these only in the backend).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=true
# When DevPilot also runs in Docker, reach Langfuse through the host gateway.
DEVPILOT_LANGFUSE_DOCKER_BASE_URL=http://host.docker.internal:3000
